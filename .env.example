# Copy to .env and fill in. Never commit .env.
# On Hugging Face Spaces these go in Settings -> Secrets (not Variables).

# --- LLM provider -------------------------------------------------------
# "groq" (default) or "claude". STT and TTS always run on Groq regardless.
LLM_PROVIDER=groq

# --- Groq: one key covers STT + LLM + TTS -------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Anthropic (only when LLM_PROVIDER=claude) --------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- n8n ----------------------------------------------------------------
# Cloud trial:  https://<your-instance>.app.n8n.cloud
# Self-hosted:  http://localhost:5678  (or your Cloudflare Tunnel URL)
# Swapping these two lines is the entire day-15 migration.
N8N_BASE_URL=
# n8n UI -> Settings -> n8n API -> Create an API key
N8N_API_KEY=
# Workflows carrying this tag are exposed to the agent as tools.
N8N_TOOL_TAG=agent-tool

# --- Telegram (async callback leg) --------------------------------------
# Create a bot via @BotFather, then message it once and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Hugging Face (deploy target; only needed by preflight + CI) --------
# https://huggingface.co/settings/tokens  (a read token is enough for preflight)
HF_TOKEN=

# --- Tuning -------------------------------------------------------------
STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=llama-3.3-70b-versatile
TTS_MODEL=playai-tts
TTS_VOICE=Fritz-PlayAI
REGISTRY_CACHE_TTL=60
MAX_TOOL_ITERATIONS=6
