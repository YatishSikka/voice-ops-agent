# Copy to .env and fill in. Never commit .env.
# On Hugging Face Spaces these go in Settings -> Secrets (not Variables).

# --- LLM provider -------------------------------------------------------
# "groq" (default) or "claude". STT and TTS always run on Groq regardless.
LLM_PROVIDER=groq

# --- Groq: one key covers STT + LLM + TTS -------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Anthropic (only when LLM_PROVIDER=claude) --------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- n8n ----------------------------------------------------------------
# Self-hosted (`npx n8n start`): http://localhost:5678
# Once the HF Space needs to reach it, swap in the Cloudflare Tunnel URL --
# that swap is the whole deployment change.
#
# NOTE: n8n Cloud's trial disables the public API (Settings -> n8n API is
# hidden and /api/v1/* returns 404), so workflows cannot be discovered
# there. Self-hosted community edition has the same API for free.
N8N_BASE_URL=http://localhost:5678
# n8n UI -> Settings -> n8n API -> Create an API key  (self-hosted only)
N8N_API_KEY=
# Workflows carrying this tag are exposed to the agent as tools.
N8N_TOOL_TAG=agent-tool

# --- Telegram (async callback leg) --------------------------------------
# Create a bot via @BotFather, then message it once and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Who may use the bot. A bot username is public and these tools read and write
# a real calendar, so anyone who finds the bot could otherwise use it. Comma
# separated; defaults to TELEGRAM_CHAT_ID alone.
TELEGRAM_ALLOWED_CHATS=

# --- Hugging Face (deploy target; only needed by preflight + CI) --------
# https://huggingface.co/settings/tokens  (a read token is enough for preflight)
HF_TOKEN=

# --- Tuning -------------------------------------------------------------
STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=llama-3.3-70b-versatile
# playai-tts was decommissioned by Groq. Orpheus is the current TTS and
# needs a one-time terms acceptance in the console before it will answer:
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# Valid voices: autumn diana hannah austin daniel troy
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=autumn
REGISTRY_CACHE_TTL=60
MAX_TOOL_ITERATIONS=6
